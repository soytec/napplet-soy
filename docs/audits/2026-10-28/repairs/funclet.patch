+test('decorative sound sessions yield before radio connection and resume only without a radio session', async () => {
+  const instances = [];
+  class Audio {
+    disposed = false;
+    activations = 0;
+    constructor() { instances.push(this); }
+    activate() { this.activations++; return false; }
+    dispose() { this.disposed = true; }
+  }
+  const { ControlSounds } = await loadModule('control-sounds', {
+    './domain-availability.js': { runtimeHasDomain: () => true },
+    '@napplet/sdk': { media: {} },
+    './coordinated-audio.js': { CoordinatedAudio: Audio },
+  });
+  const sounds = new ControlSounds();
+  sounds.play('tick');
+  assert.equal(instances[0].activations, 1);
+  sounds.setRadioActive(true); // RadioPlayer reports connecting synchronously, before its grant.
+  assert.equal(instances[0].disposed, true);
+  sounds.play('chunk');
+  assert.equal(instances[0].activations, 1);
+  sounds.setRadioActive(false); // Failed/destroyed stream; no competing radio owner.
+  sounds.play('tick');
+  assert.equal(instances[1].activations, 1);
+  sounds.dispose(); sounds.setRadioActive(false); sounds.play('tick');
+  assert.equal(instances[1].disposed, true);
+  assert.equal(instances[1].activations, 1);
+});
